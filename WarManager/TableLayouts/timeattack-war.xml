<!-- WAR_SCRIPT_START -->
*** SB_Boot ***
***
    declare warSummaryFrame <=> (Page.MainFrame.GetFirstChild("war-scoreboard-summary") as CMlFrame);
    declare warSlotsFrame <=> (Page.MainFrame.GetFirstChild("fillable_slots") as CMlFrame);
    declare warPagerFrame <=> (Page.MainFrame.GetFirstChild("page").Parent as CMlFrame);
    declare warTeamA <=> (Page.MainFrame.GetFirstChild("war-team-a") as CMlLabel);
    declare warTeamB <=> (Page.MainFrame.GetFirstChild("war-team-b") as CMlLabel);
    declare warTeamAPoints <=> (Page.MainFrame.GetFirstChild("war-team-a-points") as CMlLabel);
    declare warTeamBPoints <=> (Page.MainFrame.GetFirstChild("war-team-b-points") as CMlLabel);
    declare warStatus <=> (Page.MainFrame.GetFirstChild("war-summary-status") as CMlLabel);
    declare warTeamAColor <=> (Page.MainFrame.GetFirstChild("war-team-a-color") as CMlLabel);
    declare warTeamBColor <=> (Page.MainFrame.GetFirstChild("war-team-b-color") as CMlLabel);
***

*** SB_Loop ***
***
    declare Boolean WarManager_Visible for UIManager = False;
    declare Text WarManager_TeamA for UIManager = "";
    declare Text WarManager_TeamB for UIManager = "";
    declare Integer WarManager_TeamAPoints for UIManager = 0;
    declare Integer WarManager_TeamBPoints for UIManager = 0;
    declare Text WarManager_Status for UIManager = "";
    declare Integer WarManager_MapsPlayed for UIManager = 0;
    declare Integer WarManager_MapsTotal for UIManager = 0;
    declare Text WarManager_TimeLeft for UIManager = "";
    declare Text WarManager_TeamAColor for UIManager = "FFF";
    declare Text WarManager_TeamBColor for UIManager = "FFF";

    warSummaryFrame.Visible = WarManager_Visible;
    if (WarManager_Visible) {
        warSlotsFrame.RelativePosition_V3 = <0., 8., 0.>;
        warPagerFrame.RelativePosition_V3 = <-14., -73., 0.>;
        warTeamA.Value = WarManager_TeamA;
        warTeamB.Value = WarManager_TeamB;
        warTeamAPoints.Value = WarManager_TeamAPoints ^ "";
        warTeamBPoints.Value = WarManager_TeamBPoints ^ "";
        if (WarManager_Status == "FINISHED" || WarManager_Status == "CANCELLED") {
            warStatus.Value = WarManager_Status ^ "  |  Maps " ^ WarManager_MapsPlayed ^ " / " ^ WarManager_MapsTotal;
        } else {
            warStatus.Value = WarManager_Status ^ "  |  Maps " ^ WarManager_MapsPlayed ^ " / " ^
                WarManager_MapsTotal ^ "  |  Remaining " ^ WarManager_TimeLeft;
        }
        warTeamAColor.Value = "$" ^ WarManager_TeamAColor ^ "|";
        warTeamBColor.Value = "$" ^ WarManager_TeamBColor ^ "|";
    } else {
        warSlotsFrame.RelativePosition_V3 = <0., 15., 0.>;
        warPagerFrame.RelativePosition_V3 = <-14., -66., 0.>;
    }
***
<!-- WAR_SCRIPT_END -->
