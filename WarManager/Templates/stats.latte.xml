<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<manialink version="3" id="WarManagerStats" name="EvoSC:WarManagerStats">
    {include isManiaPlanet() ? 'Components.stylesheet' : 'Components.stylesheet_noblur'}

    <frame pos="0 37" halign="center" z-index="8450">
        <quad pos="-55 0" size="110 74" bgcolor="131313F7" />
        <quad pos="-55 0" size="110 0.4" bgcolor="E4DA72CC" />
        <label pos="-50 -5" text="STATS" textsize="1.65" textcolor="E4DA72FF" valign="center" />
        <label pos="50 -5" text="X" textsize="1.8" textcolor="F5F5F5FF" halign="center" valign="center" action="war.stats.close" />
        <quad pos="-50 -9" size="100 0.25" bgcolor="333333FF" />

        <label pos="-33 -14" text="OVERVIEW" textsize="1.05" textcolor="{$tab == 'overview' ? 'E4DA72FF' : 'A6A6A6FF'}" halign="center" action="war.stats.overview" />
        <label pos="0 -14" text="MAPS" textsize="1.05" textcolor="{$tab == 'maps' ? 'E4DA72FF' : 'A6A6A6FF'}" halign="center" action="war.stats.maps" />
        <label pos="33 -14" text="HISTORY" textsize="1.05" textcolor="{$tab == 'history' ? 'E4DA72FF' : 'A6A6A6FF'}" halign="center" action="war.stats.history" />
        <quad pos="-50 -17" size="100 0.2" bgcolor="333333FF" />

        {if $tab == 'overview'}
            <quad pos="-49 -21" size="23 20" bgcolor="1A1A1AFF" />
            <quad pos="-24 -21" size="23 20" bgcolor="1A1A1AFF" />
            <quad pos="1 -21" size="23 20" bgcolor="1A1A1AFF" />
            <quad pos="26 -21" size="23 20" bgcolor="1A1A1AFF" />
            <label pos="-46 -25" text="STATUS" textsize="0.75" textcolor="A6A6A6FF" />
            <label pos="-46 -33" size="20 4" text="{$displayStatus}" textsize="1.1" textcolor="E4DA72FF" />
            <label pos="-21 -25" text="MAP" textsize="0.75" textcolor="A6A6A6FF" />
            <label pos="-21 -33" text="{$rotationPosition} / {$mapCount}" textsize="1.35" textcolor="F5F5F5FF" />
            <label pos="4 -25" text="REMAINING" textsize="0.75" textcolor="A6A6A6FF" />
            <label pos="4 -33" text="{$timeLeft}" textsize="1.35" textcolor="F5F5F5FF" />
            <label pos="29 -25" text="ROTATION" textsize="0.75" textcolor="A6A6A6FF" />
            <label pos="29 -33" text="{$rotationNumber}" textsize="1.35" textcolor="F5F5F5FF" />

            <quad pos="-49 -44" size="98 18" bgcolor="1A1A1AFF" />
            <label pos="-45 -49" text="CURRENT MAP" textsize="0.75" textcolor="A6A6A6FF" />
            <label pos="-45 -57" size="75 5" text="{$currentMapName}" textsize="1.65" textcolor="{$currentMapValid ? 'F5F5F5FF' : 'E4DA72FF'}" />
            <label pos="45 -57" text="{$rotationPosition} / {$mapCount}" textsize="1" textcolor="E4DA72FF" halign="right" />
            {if !$currentMapValid and $war->status == 'ACTIVE'}
                <label pos="-45 -62" text="MAP NOT PART OF SCRIM - SCORING PAUSED" textsize="0.8" textcolor="E4DA72FF" />
            {/if}
        {/if}

        {if $tab == 'maps'}
            <label pos="-47 -22" text="#" textsize="0.8" textcolor="A6A6A6FF" />
            <label pos="-39 -22" text="WAR MAP" textsize="0.8" textcolor="A6A6A6FF" />
            <label pos="47 -22" text="STATUS" textsize="0.8" textcolor="A6A6A6FF" halign="right" />
            {foreach $visibleMapRows as $row}
                {if $row->status == 'CURRENT'}
                    <quad pos="-49 {$iterator->counter * -4.5 - 20}" size="0.8 3.6" bgcolor="E4DA72FF" />
                {/if}
                <label pos="-46 {$iterator->counter * -4.5 - 22}" text="{$iterator->counter + (($mapPage - 1) * 10)}" textsize="0.85" textcolor="A6A6A6FF" />
                <label pos="-38 {$iterator->counter * -4.5 - 22}" size="60 3.5" text="{$row->name}" textsize="0.95" textcolor="F5F5F5FF" />
                <label pos="47 {$iterator->counter * -4.5 - 22}" text="{$row->status}" textsize="0.85" textcolor="{$row->status == 'CURRENT' ? 'E4DA72FF' : 'A6A6A6FF'}" halign="right" />
            {/foreach}
            <label pos="-45 -70" text="PREV" textsize="0.9" textcolor="E4DA72FF" action="war.stats.maps.previous" />
            <label pos="0 -70" text="{$mapPage} / {$mapPageCount}" textsize="0.85" textcolor="A6A6A6FF" halign="center" />
            <label pos="45 -70" text="NEXT" textsize="0.9" textcolor="E4DA72FF" halign="right" action="war.stats.maps.next" />
        {/if}

        {if $tab == 'history'}
            <label pos="-47 -22" text="COMPLETED MAP RESULTS" textsize="0.8" textcolor="A6A6A6FF" />
            {if $historyRows->isEmpty()}
                <label pos="0 -38" text="NO STORED MAP RESULTS YET" textsize="1" textcolor="A6A6A6FF" halign="center" />
            {/if}
            {foreach $historyRows as $row}
                <label pos="-47 {$iterator->counter * -7 - 22}" size="45 3.5" text="{$row->name}" textsize="0.9" textcolor="F5F5F5FF" />
                <label pos="47 {$iterator->counter * -7 - 22}" text="{$war->team_a}  {$row->team_a_points} : {$row->team_b_points}  {$war->team_b}" textsize="0.95" textcolor="E4DA72FF" halign="right" />
            {/foreach}
        {/if}
    </frame>
</manialink>
