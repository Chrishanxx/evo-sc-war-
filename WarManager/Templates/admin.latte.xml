        <label id="war-admin-back" pos="0 -89" size="128 4" text="A / ENTER  SELECT     B / ESC  BACK     LB / RB  TABS" textsize="0.68" textcolor="888888FF" halign="center" action="{$backAction}" scriptevents="1" focusareacolor1="00000000" focusareacolor2="E4DA7244" />
    </frame>
    <script><!--
        main()
        {
            declare BackControl = Page.GetFirstChild("war-admin-back");
            declare DefaultControl = Page.GetFirstChild("{$defaultFocusId}");
            declare persistent Text P_WarAdminFocusOverview for LocalUser = "";
            declare persistent Text P_WarAdminFocusMaps for LocalUser = "";
            declare persistent Text P_WarAdminFocusCreate for LocalUser = "";
            declare persistent Text P_WarAdminFocusPoints for LocalUser = "";
            declare persistent Text P_WarAdminFocusLogs for LocalUser = "";
            declare persistent Text P_WarAdminFocusRotation for LocalUser = "";
            declare persistent Text P_WarAdminFocusPlayers for LocalUser = "";
            declare persistent Text P_WarAdminFocusConfirm for LocalUser = "";
            declare PageKey = "{$confirmAction ? 'confirm' : $tab}";
            declare SavedFocusId = "";
            if (PageKey == "overview") SavedFocusId = P_WarAdminFocusOverview;
            else if (PageKey == "maps") SavedFocusId = P_WarAdminFocusMaps;
            else if (PageKey == "create") SavedFocusId = P_WarAdminFocusCreate;
            else if (PageKey == "points") SavedFocusId = P_WarAdminFocusPoints;
            else if (PageKey == "logs") SavedFocusId = P_WarAdminFocusLogs;
            else if (PageKey == "rotation") SavedFocusId = P_WarAdminFocusRotation;
            else if (PageKey == "players") SavedFocusId = P_WarAdminFocusPlayers;
            else if (PageKey == "confirm") SavedFocusId = P_WarAdminFocusConfirm;

            EnableMenuNavigation(True, True, True, BackControl, 100);
            declare InitialControl = Page.GetFirstChild(SavedFocusId);
            if (InitialControl != Null) InitialControl.Focus();
            else if (DefaultControl != Null) DefaultControl.Focus();

            while (True)
            {
                yield;
                if (PageKey == "confirm" && Page.FocusedControl != Null &&
                    Page.FocusedControl.ControlId != "war-admin-confirm-back" &&
                    Page.FocusedControl.ControlId != "war-admin-confirm-yes" &&
                    Page.FocusedControl.ControlId != "war-admin-back")
                {
                    if (DefaultControl != Null) DefaultControl.Focus();
                }
                if (Page.FocusedControl != Null && Page.FocusedControl.ControlId != "")
                {
                    SavedFocusId = Page.FocusedControl.ControlId;
                    if (PageKey == "overview") P_WarAdminFocusOverview = SavedFocusId;
                    else if (PageKey == "maps") P_WarAdminFocusMaps = SavedFocusId;
                    else if (PageKey == "create") P_WarAdminFocusCreate = SavedFocusId;
                    else if (PageKey == "points") P_WarAdminFocusPoints = SavedFocusId;
                    else if (PageKey == "logs") P_WarAdminFocusLogs = SavedFocusId;
                    else if (PageKey == "rotation") P_WarAdminFocusRotation = SavedFocusId;
                    else if (PageKey == "players") P_WarAdminFocusPlayers = SavedFocusId;
                    else if (PageKey == "confirm") P_WarAdminFocusConfirm = SavedFocusId;
                }
                foreach (Event in PendingEvents)
                {
                    if (Event.Type == CMlScriptEvent::Type::MenuNavigation)
                    {
                        if (PageKey != "confirm" && Event.MenuNavAction == CMlScriptEvent::EMenuNavAction::PageUp)
                            TriggerPageAction("{$previousTabAction}");
                        else if (PageKey != "confirm" && Event.MenuNavAction == CMlScriptEvent::EMenuNavAction::PageDown)
                            TriggerPageAction("{$nextTabAction}");
                        if (Page.FocusedControl != Null) Page.ScrollToControl(Page.FocusedControl);
                    }
                    else if ((Event.Type == CMlScriptEvent::Type::MouseClick || Event.Type == CMlScriptEvent::Type::MouseOver) && Event.Control != Null)
                    {
                        Event.Control.Focus();
                    }
                }
            }
        }
    --></script>
</manialink>
