                <label id="war-admin-confirm-back" pos="20 -16" size="26 6" text="BACK" textsize="1.5" textcolor="FFFFFFFF" halign="center" action="war.admin.overview" scriptevents="1" focusareacolor1="00000000" focusareacolor2="E4DA7255" />
                {if $confirmAction == 'start'}
                    <label id="war-admin-confirm-yes" pos="68 -16" size="30 6" text="CONFIRM" textsize="1.5" textcolor="50CF84FF" halign="center" action="war.admin.confirm.start" scriptevents="1" focusareacolor1="00000000" focusareacolor2="E4DA7255" />
                {/if}
                {if $confirmAction == 'pause'}
                    <label id="war-admin-confirm-yes" pos="68 -16" size="30 6" text="CONFIRM" textsize="1.5" textcolor="D8D184FF" halign="center" action="war.admin.confirm.pause" scriptevents="1" focusareacolor1="00000000" focusareacolor2="E4DA7255" />
                {/if}
                {if $confirmAction == 'resume'}
                    <label id="war-admin-confirm-yes" pos="68 -16" size="30 6" text="CONFIRM" textsize="1.5" textcolor="50CF84FF" halign="center" action="war.admin.confirm.resume" scriptevents="1" focusareacolor1="00000000" focusareacolor2="E4DA7255" />
                {/if}
                {if $confirmAction == 'finish'}
                    <label id="war-admin-confirm-yes" pos="68 -16" size="30 6" text="CONFIRM" textsize="1.5" textcolor="F05D5EFF" halign="center" action="war.admin.confirm.finish" scriptevents="1" focusareacolor1="00000000" focusareacolor2="F05D5E55" />
                {/if}
                {if $confirmAction == 'cancel'}
                    <label id="war-admin-confirm-yes" pos="68 -16" size="30 6" text="CONFIRM" textsize="1.5" textcolor="F05D5EFF" halign="center" action="war.admin.confirm.cancel" scriptevents="1" focusareacolor1="00000000" focusareacolor2="F05D5E55" />
                {/if}
                {if $confirmAction == 'scoring_pause'}
                    <label id="war-admin-confirm-yes" pos="68 -16" size="34 6" text="PAUSE SCORING" textsize="1.2" textcolor="E4DA72FF" halign="center" action="war.admin.confirm.scoring.pause" scriptevents="1" focusareacolor1="00000000" focusareacolor2="E4DA7255" />
