{contentType text}
<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<manialink version="3" id="WarManagerAdmin" name="EvoSC:WarManagerAdmin">
    {include isManiaPlanet() ? 'Components.stylesheet' : 'Components.stylesheet_noblur'}

    <frame pos="0 46" halign="center" z-index="8600">
        <quad pos="-76 0" size="152 92" bgcolor="131313F7" />
        <quad pos="-76 0" size="152 10" bgcolor="1A1A1AFF" />
        <label pos="-71 -5" text="ADMIN" textsize="2.3" textcolor="E4DA72FF" valign="center" />
        <label pos="71 -5" text="X" textsize="2.6" textcolor="FFFFFFFF" halign="center" valign="center" action="war.admin.close" />

        <frame pos="-71 -13">
            <label pos="0 0" text="GENERAL" textsize="1.1" textcolor="{$tab == 'overview' ? 'E4DA72FF' : 'A6A6A6FF'}" action="war.admin.overview" />
            <label pos="29 0" text="MAP POOL" textsize="1.1" textcolor="{$tab == 'maps' ? 'E4DA72FF' : 'A6A6A6FF'}" action="war.admin.maps" />
            <label pos="63 0" text="TEAMS" textsize="1.1" textcolor="{$tab == 'create' ? 'E4DA72FF' : 'A6A6A6FF'}" action="war.admin.create.tab" />
            <label pos="96 0" text="POINTS" textsize="1.1" textcolor="{$tab == 'points' ? 'E4DA72FF' : 'A6A6A6FF'}" action="war.admin.points" />
            <label pos="130 0" text="LOGS" textsize="1.1" textcolor="{$tab == 'logs' ? 'E4DA72FF' : 'A6A6A6FF'}" action="war.admin.logs" />
        </frame>
        <quad pos="-71 -17" size="142 0.4" bgcolor="E4DA72FF" />

        {if $tab == 'overview'}
            {if $war}
                <label pos="0 -24" text="{$war->name}" textsize="3" textcolor="FFFFFFFF" halign="center" />
                <label pos="0 -33" text="{$war->team_a}  {$teamAPoints}  :  {$teamBPoints}  {$war->team_b}" textsize="5" textcolor="FFFFFFFF" halign="center" />
                <label pos="0 -41" text="{$war->status}  |  {$timeLeft} remaining" textsize="1.8" textcolor="A9B7C3FF" halign="center" />
                <label pos="-52 -50" text="Maps: {$maps->count()}" textsize="1.6" textcolor="D8D184FF" />
                <label pos="20 -50" text="Players: {$players->count()}" textsize="1.6" textcolor="D8D184FF" />
                {if $ready}
                    <label pos="0 -56" text="READY TO START" textsize="1.5" textcolor="50CF84FF" halign="center" />
                {/if}

                {if $war->status == 'DRAFT'}
                    <label pos="0 -66" text="START WAR" textsize="1.8" textcolor="50CF84FF" halign="center" action="war.admin.control.start" />
                {/if}
                {if $war->status == 'ACTIVE'}
                    <label pos="-25 -66" text="PAUSE" textsize="1.8" textcolor="D8D184FF" halign="center" action="war.admin.control.pause" />
                    <label pos="25 -66" text="FINISH" textsize="1.8" textcolor="50CF84FF" halign="center" action="war.admin.control.finish" />
                    <label pos="0 -74" text="CANCEL WAR" textsize="1.4" textcolor="F05D5EFF" halign="center" action="war.admin.control.cancel" />
                    {if $scoringPaused}
                        <label pos="0 -82" text="RESUME SCORING" textsize="1.3" textcolor="50CF84FF" halign="center" action="war.admin.control.scoring.resume" />
                    {else}
                        <label pos="0 -82" text="PAUSE SCORING" textsize="1.3" textcolor="E4DA72FF" halign="center" action="war.admin.control.scoring.pause" />
                    {/if}
                {/if}
                {if $war->status == 'PAUSED'}
                    <label pos="-25 -66" text="RESUME" textsize="1.8" textcolor="50CF84FF" halign="center" action="war.admin.control.resume" />
                    <label pos="25 -66" text="FINISH" textsize="1.8" textcolor="FFFFFFFF" halign="center" action="war.admin.control.finish" />
                    <label pos="0 -74" text="CANCEL WAR" textsize="1.4" textcolor="F05D5EFF" halign="center" action="war.admin.control.cancel" />
                {/if}
            {else}
                <label pos="0 -34" text="NO WAR EXISTS" textsize="3" textcolor="FFFFFFFF" halign="center" />
                <label pos="0 -44" text="Open CREATE / SETTINGS to configure a new war." textsize="1.6" textcolor="A9B7C3FF" halign="center" />
            {/if}
        {/if}

        {if $tab == 'create'}
            {if $current}
                <label pos="-66 -24" text="WAR SETTINGS (DRAFT ONLY)" textsize="2" textcolor="D8D184FF" />
                <label pos="-66 -32" text="War name" textsize="1.2" textcolor="A9B7C3FF" />
                <entry pos="-66 -35" size="60 6" name="war_name" default="{$current->name}" textsize="1.4" />
                <label pos="-66 -46" text="Team A" textsize="1.2" textcolor="A9B7C3FF" />
                <entry pos="-66 -49" size="42 6" name="team_a" default="{$current->team_a}" textsize="1.4" />
                <label pos="-18 -46" text="Team B" textsize="1.2" textcolor="A9B7C3FF" />
                <entry pos="-18 -49" size="42 6" name="team_b" default="{$current->team_b}" textsize="1.4" />
                <label pos="30 -46" text="Duration (1-14 days)" textsize="1.2" textcolor="A9B7C3FF" />
                <entry pos="30 -49" size="30 6" name="duration" default="{$current->duration_days}" textsize="1.4" />
                <label pos="-66 -60" text="Overlay join 1/0" textsize="1.1" textcolor="A9B7C3FF" />
                <entry pos="-66 -63" size="20 5" name="overlay_join" default="{$current->overlay_join_enabled}" textsize="1.2" />
                <label pos="-38 -60" text="Tag detection 1/0" textsize="1.1" textcolor="A9B7C3FF" />
                <entry pos="-38 -63" size="20 5" name="nickname_detection" default="{$current->nickname_detection_enabled}" textsize="1.2" />
                <label pos="-10 -60" text="Team limit (0 = none)" textsize="1.1" textcolor="A9B7C3FF" />
                <entry pos="-10 -63" size="24 5" name="team_limit" default="{$current->team_limit ?: 0}" textsize="1.2" />
                <quad pos="37 -75" size="29 7" bgcolor="D8D184FF" action="war.admin.settings.save" />
                <label pos="51.5 -78.5" text="SAVE SETTINGS" textsize="1.3" textcolor="000000FF" halign="center" valign="center" action="war.admin.settings.save" />
            {else}
                <label pos="-66 -24" text="CREATE WAR" textsize="2" textcolor="D8D184FF" />
                <label pos="-66 -32" text="War name (optional)" textsize="1.2" textcolor="A9B7C3FF" />
                <entry pos="-66 -35" size="60 6" name="war_name" default="" textsize="1.4" />
                <label pos="-66 -46" text="Team A" textsize="1.2" textcolor="A9B7C3FF" />
                <entry pos="-66 -49" size="42 6" name="team_a" default="FAST" textsize="1.4" />
                <label pos="-18 -46" text="Team B" textsize="1.2" textcolor="A9B7C3FF" />
                <entry pos="-18 -49" size="42 6" name="team_b" default="ZOOP" textsize="1.4" />
                <label pos="30 -46" text="Duration (1-14 days)" textsize="1.2" textcolor="A9B7C3FF" />
                <entry pos="30 -49" size="30 6" name="duration" default="7" textsize="1.4" />
                <label pos="-66 -60" text="Overlay join 1/0" textsize="1.1" textcolor="A9B7C3FF" />
                <entry pos="-66 -63" size="20 5" name="overlay_join" default="1" textsize="1.2" />
                <label pos="-38 -60" text="Tag detection 1/0" textsize="1.1" textcolor="A9B7C3FF" />
                <entry pos="-38 -63" size="20 5" name="nickname_detection" default="0" textsize="1.2" />
                <label pos="-10 -60" text="Team limit (0 = none)" textsize="1.1" textcolor="A9B7C3FF" />
                <entry pos="-10 -63" size="24 5" name="team_limit" default="0" textsize="1.2" />
                <quad pos="37 -75" size="29 7" bgcolor="D8D184FF" action="war.admin.create" />
                <label pos="51.5 -78.5" text="CREATE WAR" textsize="1.3" textcolor="000000FF" halign="center" valign="center" action="war.admin.create" />
            {/if}
        {/if}

        {if $tab == 'rotation'}
            <label pos="-66 -24" text="TM_WAR_ONLINE · EXCLUSIVE ROTATION" textsize="2" textcolor="D8D184FF" />
            {if $current}
                <label pos="-66 -31" text="TimeAttack base: Trackmania/TM_TimeAttack_Online.Script.txt" textsize="1.05" textcolor="A9B7C3FF" />
                <label pos="-66 -39" text="Map time (seconds)" textsize="1.1" textcolor="A9B7C3FF" />
                <entry pos="-66 -42" size="25 5" name="map_time_limit" default="{$current->map_time_limit}" textsize="1.2" />
                <label pos="-35 -39" text="Chat time (seconds)" textsize="1.1" textcolor="A9B7C3FF" />
                <entry pos="-35 -42" size="25 5" name="chat_time" default="{$current->chat_time}" textsize="1.2" />
                <label pos="-66 -51" text="Strict War Scoring" textsize="1.1" textcolor="A9B7C3FF" />
                <label pos="-66 -55" text="ON (REQUIRED)" textsize="1.2" textcolor="50CF84FF" />
                <label pos="-38 -51" text="Repeat Playlist 1/0" textsize="1.1" textcolor="A9B7C3FF" />
                <entry pos="-38 -54" size="20 5" name="repeat_playlist" default="{$current->repeat_playlist}" textsize="1.2" />
                <label pos="-10 -51" text="Exclusive Rotation 1/0" textsize="1.1" textcolor="A9B7C3FF" />
                <entry pos="-10 -54" size="20 5" name="exclusive_rotation" default="{$current->exclusive_rotation}" textsize="1.2" />
                <label pos="18 -51" text="Safe Mode 1/0" textsize="1.1" textcolor="A9B7C3FF" />
                <entry pos="18 -54" size="20 5" name="matchsettings_safe_mode" default="{$current->matchsettings_safe_mode}" textsize="1.2" />
                <label pos="-66 -64" text="VALIDATION: {$rotationValidCount} / {$rotationMapCount} MAPS VALID" textsize="1.3" textcolor="{$rotationHasMissing ? 'F05D5EFF' : '50CF84FF'}" />
                <label pos="-66 -69" size="83 4" text="FILE: {$current->matchsettings_file ?: 'NOT GENERATED'}" textsize="1" textcolor="FFFFFFFF" />
                <label pos="18 -64" text="AUTO LOAD: OFF · AUTO RESTORE: OFF" textsize="0.95" textcolor="50CF84FF" />
                <label pos="18 -69" text="EXCLUSIVE: {$current->matchsettings_file ? 'PREPARED' : 'OFF'}" textsize="0.95" textcolor="D8D184FF" />
                <quad pos="23 -75" size="20 7" bgcolor="D8D184FF" action="war.admin.rotation.save" />
                <label pos="33 -78.5" text="SAVE" textsize="1.2" textcolor="000000FF" halign="center" valign="center" action="war.admin.rotation.save" />
                <quad pos="46 -75" size="24 7" bgcolor="50CF84FF" action="war.admin.rotation.generate" />
                <label pos="58 -78.5" text="GENERATE" textsize="1.2" textcolor="000000FF" halign="center" valign="center" action="war.admin.rotation.generate" />
            {else}
                <label pos="0 -44" text="Create a war draft before configuring the rotation." textsize="1.5" textcolor="A9B7C3FF" halign="center" />
            {/if}
        {/if}

        {if $tab == 'maps'}
            <label pos="-66 -24" text="WAR MAPS ({$maps->count()} selected)" textsize="2" textcolor="D8D184FF" />
            {if $current}
                <entry pos="-66 -30" size="48 6" name="map_uid" default="" textsize="1.3" />
                <quad pos="-15 -30" size="22 6" bgcolor="D8D184FF" action="war.admin.map.add" />
                <label pos="-4 -33" text="ADD UID" textsize="1.2" textcolor="000000FF" halign="center" valign="center" action="war.admin.map.add" />
                <quad pos="10 -30" size="25 6" bgcolor="222222FF" action="war.admin.map.add.current" />
                <label pos="22.5 -33" text="+ CURRENT MAP" textsize="0.9" textcolor="D8D184FF" halign="center" valign="center" action="war.admin.map.add.current" />
                <label pos="-66 -41" text="Selected maps" textsize="1.4" textcolor="FFFFFFFF" />
                {foreach $maps->take(7) as $map}
                    <label pos="-63 {$iterator->counter * -5 - 40}" size="53 4" text="{$iterator->counter}. {$map->map_name}" textsize="1.1" textcolor="FFFFFFFF" />
                    {if $current->status == 'DRAFT'}
                        <label pos="-7 {$iterator->counter * -5 - 40}" text="REMOVE" textsize="1" textcolor="F05D5EFF" action="war.admin.map.remove.{$iterator->counter}" />
                    {/if}
                {/foreach}
                <label pos="16 -24" text="SERVER MAPS ({$serverMapCount})" textsize="2" textcolor="D8D184FF" />
                {foreach $serverMaps as $serverMap}
                    <label pos="18 {$iterator->counter * -6 - 25}" size="37 4" text="{$serverMap->name}" textsize="1.1" textcolor="FFFFFFFF" />
                    {if $serverMap->selected}
                        <label pos="68 {$iterator->counter * -6 - 25}" text="SELECTED" textsize="1" textcolor="D8D184FF" halign="right" />
                    {else}
                        {if $current->status == 'DRAFT'}
                            <label pos="68 {$iterator->counter * -6 - 25}" text="+ ADD" textsize="1" textcolor="D8D184FF" halign="right" action="war.admin.map.add.server.{$iterator->counter}" />
                        {/if}
                    {/if}
                {/foreach}
                <label pos="29 -79" text="&lt; PREV" textsize="1.2" textcolor="{$mapPage > 1 ? 'D8D184FF' : '666666FF'}" action="war.admin.maps.previous" />
                <label pos="48 -79" text="PAGE {$mapPage} / {$mapPageCount}" textsize="1.1" textcolor="FFFFFFFF" halign="center" />
                <label pos="68 -79" text="NEXT &gt;" textsize="1.2" textcolor="{$mapPage < $mapPageCount ? 'D8D184FF' : '666666FF'}" halign="right" action="war.admin.maps.next" />
            {else}
                <label pos="0 -42" text="Create a war before selecting maps." textsize="1.7" textcolor="A9B7C3FF" halign="center" />
            {/if}
        {/if}

        {if $tab == 'points'}
            <label pos="-66 -24" text="POINT SYSTEM" textsize="2" textcolor="D8D184FF" />
            {if $current}
                <label pos="20 -24" text="LINEAR" textsize="1.3" textcolor="50CF84FF" action="war.admin.points.linear" />
                <label pos="43 -24" text="COMPETITIVE" textsize="1.3" textcolor="D8D184FF" action="war.admin.points.competitive" />
                {foreach $points as $point}
                    {if $point->rank <= 8}
                        <label pos="-62 {$point->rank * -6 - 27}" text="LR {$point->rank}" textsize="1.2" textcolor="FFFFFFFF" />
                        <entry pos="-48 {$point->rank * -6 - 25}" size="20 5" name="point_{$point->rank}" default="{$point->points}" textsize="1.2" />
                    {else}
                        <label pos="2 {($point->rank - 8) * -6 - 27}" text="LR {$point->rank}" textsize="1.2" textcolor="FFFFFFFF" />
                        <entry pos="18 {($point->rank - 8) * -6 - 25}" size="20 5" name="point_{$point->rank}" default="{$point->points}" textsize="1.2" />
                    {/if}
                {/foreach}
                <quad pos="45 -76" size="24 7" bgcolor="D8D184FF" action="war.admin.points.save" />
                <label pos="57 -79.5" text="SAVE" textsize="1.3" textcolor="000000FF" halign="center" valign="center" action="war.admin.points.save" />
            {else}
                <label pos="0 -42" text="Create a war before editing points." textsize="1.7" textcolor="A9B7C3FF" halign="center" />
            {/if}
        {/if}

        {if $tab == 'players'}
            <label pos="-66 -24" text="TEAM DETECTION" textsize="2" textcolor="D8D184FF" />
            {if $war}
                <label pos="-62 -32" text="PLAYER" textsize="1.1" textcolor="A9B7C3FF" />
                <label pos="-17 -32" text="TEAM" textsize="1.1" textcolor="A9B7C3FF" />
                <label pos="2 -32" text="PTS" textsize="1.1" textcolor="A9B7C3FF" />
                <label pos="16 -32" text="STATUS" textsize="1.1" textcolor="A9B7C3FF" />
                <label pos="38 -32" text="JOINED" textsize="1.1" textcolor="A9B7C3FF" />
                {foreach $players->take(9) as $entry}
                    <label pos="-60 {$iterator->counter * -5 - 34}" size="39 4" text="{$entry->display_name}" textsize="1" textcolor="FFFFFFFF" />
                    <label pos="-17 {$iterator->counter * -5 - 34}" text="{$entry->locked_team}" textsize="1" textcolor="D8D184FF" />
                    <label pos="5 {$iterator->counter * -5 - 34}" text="{$entry->total_points}" textsize="1" textcolor="FFFFFFFF" halign="right" />
                    <label pos="16 {$iterator->counter * -5 - 34}" text="{$entry->online ? 'ONLINE' : 'OFFLINE'}" textsize="0.9" textcolor="{$entry->online ? '50CF84FF' : '778692FF'}" />
                    <label pos="38 {$iterator->counter * -5 - 34}" size="18 4" text="{$entry->joined_at}" textsize="0.75" textcolor="FFFFFFFF" />
                    <quad pos="57 {$iterator->counter * -5 - 32.8}" size="14 3.2" bgcolor="F05D5E22" action="war.admin.player.reset.{$iterator->counter}" />
                    <label pos="64 {$iterator->counter * -5 - 34}" text="RESET TEAM" textsize="0.75" textcolor="F05D5EFF" action="war.admin.player.reset.{$iterator->counter}" halign="center" />
                {/foreach}
                <label pos="-60 -82" text="UNASSIGNED ONLINE: {$unassigned->count()}" textsize="1" textcolor="F05D5EFF" />
            {/if}
        {/if}

        {if $tab == 'logs'}
            <label pos="-66 -24" text="WAR ADMIN LOG" textsize="2" textcolor="D8D184FF" />
            {foreach $logs as $entry}
                <label pos="-63 {$iterator->counter * -7 - 25}" size="32 5" text="{$entry->created_at}" textsize="1" textcolor="778692FF" />
                <label pos="-29 {$iterator->counter * -7 - 25}" size="32 5" text="{$entry->admin_login}" textsize="1" textcolor="D8D184FF" />
                <label pos="5 {$iterator->counter * -7 - 25}" size="61 5" text="{$entry->action}" textsize="1.1" textcolor="FFFFFFFF" />
            {/foreach}
        {/if}

        {if $confirmAction}
            <frame pos="-45 -58" z-index="8700">
                <quad pos="0 0" size="90 24" bgcolor="080808FF" />
                {if $confirmAction == 'scoring_pause'}
                    <label pos="45 -6" text="PAUSE WAR SCORING?" textsize="2" textcolor="E4DA72FF" halign="center" />
                {elseif $confirmAction == 'scoring_resume'}
                    <label pos="45 -6" text="RESUME WAR SCORING?" textsize="2" textcolor="50CF84FF" halign="center" />
                {else}
                    <label pos="45 -6" text="CONFIRM {$confirmAction} WAR?" textsize="2" textcolor="F05D5EFF" halign="center" />
                {/if}
                <label pos="20 -16" text="BACK" textsize="1.5" textcolor="FFFFFFFF" halign="center" action="war.admin.overview" />
                {if $confirmAction == 'start'}
                    <label pos="68 -16" text="CONFIRM" textsize="1.5" textcolor="50CF84FF" halign="center" action="war.admin.confirm.start" />
                {/if}
                {if $confirmAction == 'pause'}
                    <label pos="68 -16" text="CONFIRM" textsize="1.5" textcolor="D8D184FF" halign="center" action="war.admin.confirm.pause" />
                {/if}
                {if $confirmAction == 'resume'}
                    <label pos="68 -16" text="CONFIRM" textsize="1.5" textcolor="50CF84FF" halign="center" action="war.admin.confirm.resume" />
                {/if}
                {if $confirmAction == 'finish'}
                    <label pos="68 -16" text="CONFIRM" textsize="1.5" textcolor="F05D5EFF" halign="center" action="war.admin.confirm.finish" />
                {/if}
                {if $confirmAction == 'cancel'}
                    <label pos="68 -16" text="CONFIRM" textsize="1.5" textcolor="F05D5EFF" halign="center" action="war.admin.confirm.cancel" />
                {/if}
                {if $confirmAction == 'scoring_pause'}
                    <label pos="68 -16" text="PAUSE SCORING" textsize="1.2" textcolor="E4DA72FF" halign="center" action="war.admin.confirm.scoring.pause" />
                {/if}
                {if $confirmAction == 'scoring_resume'}
                    <label pos="68 -16" text="RESUME SCORING" textsize="1.2" textcolor="50CF84FF" halign="center" action="war.admin.confirm.scoring.resume" />
                {/if}
            </frame>
        {/if}
    </frame>
</manialink>
