                    <label id="war-admin-confirm-yes" pos="68 -16" size="36 6" text="RESUME SCORING" textsize="1.2" textcolor="50CF84FF" halign="center" action="war.admin.confirm.scoring.resume" scriptevents="1" focusareacolor1="00000000" focusareacolor2="E4DA7255" />
