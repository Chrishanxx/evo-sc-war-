{contentType text}
<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<manialink version="3" id="WarManager" name="EvoSC:WarManager">
    {include isManiaPlanet() ? 'Components.stylesheet' : 'Components.stylesheet_noblur'}

    <frame pos="0 45" halign="center" z-index="8500">
        <quad pos="-72 0" size="144 88" bgcolor="000000F2" />
        <quad pos="-72 0" size="144 10" bgcolor="080808FF" />
        <label pos="-67 -5" text="WAR MANAGER" textsize="2.5" textcolor="39C9F2FF" valign="center" />
        <label pos="67 -5" text="X" textsize="3" textcolor="FFFFFFFF" halign="center" valign="center" action="war.close" />

        <label pos="0 -15" text="{$war->name}" textsize="3" textcolor="FFFFFFFF" halign="center" />
        <label pos="0 -22" text="{$war->team_a}  {$teamAPoints}  :  {$teamBPoints}  {$war->team_b}" textsize="5" textcolor="FFFFFFFF" halign="center" />
        <label pos="0 -29" text="{$war->status}  |  {$timeLeft}" textsize="1.5" textcolor="A9B7C3FF" halign="center" />

        <frame pos="-67 -35">
            <quad size="64 31" bgcolor="080808FF" />
            <label pos="3 -4" text="MAPS" textsize="1.7" textcolor="39C9F2FF" />
            {foreach $mapRows as $row}
                <label pos="3 {$iterator->counter * -5 - 5}" size="42 4" text="{$row->name}" textsize="1.1" textcolor="FFFFFFFF" />
                <label pos="60 {$iterator->counter * -5 - 5}" text="{$row->team_a_points} : {$row->team_b_points}" textsize="1.1" textcolor="FFFFFFFF" halign="right" />
            {/foreach}
        </frame>

        <frame pos="3 -35">
            <quad size="64 31" bgcolor="080808FF" />
            <label pos="3 -4" text="PLAYERS" textsize="1.7" textcolor="F5A934FF" />
            {foreach $players as $entry}
                <label pos="3 {$iterator->counter * -5 - 5}" size="40 4" text="{$iterator->counter}. {$entry->display_name}" textsize="1.1" textcolor="FFFFFFFF" />
                <label pos="60 {$iterator->counter * -5 - 5}" text="{$entry->total_points}" textsize="1.1" textcolor="FFFFFFFF" halign="right" />
            {/foreach}
        </frame>

        {if $canManage}
            {if $war->status == 'DRAFT'}
                <frame pos="-67 -70">
                    <label pos="0 -3" text="ADMIN - TEAM NAMES (editable until start)" textsize="1.3" textcolor="50CF84FF" />
                    <entry pos="0 -8" size="31 5" name="team_a" default="{$war->team_a}" textsize="1.2" />
                    <entry pos="34 -8" size="31 5" name="team_b" default="{$war->team_b}" textsize="1.2" />
                    <entry pos="68 -8" size="40 5" name="war_name" default="{$war->name}" textsize="1.2" />
                    <quad pos="111 -8" size="20 5" bgcolor="39C9F2FF" action="war.teams.save" />
                    <label pos="121 -10.5" text="SAVE" textsize="1.2" textcolor="101820FF" halign="center" valign="center" />
                </frame>
            {/if}
        {/if}
    </frame>
</manialink>
